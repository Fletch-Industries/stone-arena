{
  "name": "stone-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "game": "node scripts/availability.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.16",
    "@colyseus/schema": "5.0.34",
    "@colyseus/sdk": "0.18.4",
    "@colyseus/ws-transport": "0.18.3",
    "express": "5.2.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
